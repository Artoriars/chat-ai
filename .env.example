# ===== 基础设施凭据（docker-compose 使用）=====
CHATBI_DB_PASSWORD=chatbi_dev_123
CHATBI_PG_PASSWORD=chatbi_pg_123

# ===== LLM（OpenAI 兼容协议，任意网关可切换）=====
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.1

# ===== 数据库连接（backend 使用；本机 compose 映射端口 13306）=====
META_DB_URL=mysql+pymysql://root:${CHATBI_DB_PASSWORD}@localhost:13306/chatbi_meta
BUSINESS_DB_URL=mysql+pymysql://root:${CHATBI_DB_PASSWORD}@localhost:13306/business_demo

# ===== SQL 安全检查参数 =====
MAX_EXPLAIN_ROWS=1000000
DEFAULT_ROW_LIMIT=50
MAX_ROW_LIMIT=1000

# ===== Embedding（OpenAI 兼容协议；不配则检索降级为全量 schema 进 prompt）=====
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# ===== LangGraph Postgres Checkpointer（多轮会话持久化）=====
CHATBI_PG_DSN=postgresql://postgres:chatbi_pg_123@localhost:15432/postgres

# ===== 检索参数 =====
RETRIEVE_TOP_K=8
MAX_CONTEXT_TABLES=12

# ===== LangSmith 观测（可选，不配或置 false 则关闭）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chat-bi

# ===== M3: 自愈重试（初始生成之外的最大修复次数）=====
MAX_SQL_RETRIES=2

# ===== M3: Redis（导出队列 / 任务状态 / QA 去重）=====
REDIS_URL=redis://localhost:16379/0

# ===== M3: Excel 导出 =====
EXPORT_MAX_ROWS=5000
# 不填则默认 backend/exports/
EXPORT_DIR=

# ===== M3: schema 定时 diff（秒；0=关闭，仅手动/query-time 触发）=====
SCHEMA_SYNC_INTERVAL_SECONDS=0

# ===== M3: question-SQL 沉淀 dataset（需同时配置 LANGSMITH_API_KEY）=====
LANGSMITH_DATASET=chatbi-regression
