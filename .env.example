# ===== 基础设施凭据（docker-compose 使用）=====
CHATBI_DB_PASSWORD=chatbi_dev_123
CHATBI_PG_PASSWORD=chatbi_pg_123

# ===== LLM（OpenAI 兼容协议，任意网关可切换）=====
LLM_BASE_URL=https://your-gateway.example.com/v1
LLM_API_KEY=sk-your-key
LLM_MODEL=your-model-name
LLM_TEMPERATURE=0.1

# ===== 数据库连接（backend 使用；本机 compose 映射端口 13306）=====
META_DB_URL=mysql+pymysql://root:${CHATBI_DB_PASSWORD}@localhost:13306/chatbi_meta
BUSINESS_DB_URL=mysql+pymysql://root:${CHATBI_DB_PASSWORD}@localhost:13306/business_demo

# ===== SQL 安全检查参数 =====
MAX_EXPLAIN_ROWS=1000000
DEFAULT_ROW_LIMIT=50
MAX_ROW_LIMIT=1000

# ===== LangSmith 观测（可选，不配或置 false 则关闭）=====
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chat-bi
